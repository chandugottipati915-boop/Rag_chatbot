# Copy to .env and fill in. Never commit .env.
EMBEDDING_PROVIDER=local          # local (BGE, free) or openai
OPENAI_API_KEY=                   # needed for answers (gpt-4o-mini) and the eval judge
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag   # chat history (docker run ... postgres:17)

# LangSmith tracing (optional): every chat turn becomes one trace with the graph steps and LLM calls
LANGSMITH_TRACING=false           # true to send traces
LANGSMITH_API_KEY=                # smith.langchain.com → Settings → API Keys
LANGSMITH_PROJECT=rag-chatbot

# Auth: signs the session cookies. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
COOKIE_SECURE=false               # true in production (served over HTTPS)
